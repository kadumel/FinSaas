# Copie para .env e preencha os valores.
# Nunca commite o arquivo .env (ele está no .gitignore).

DJANGO_SECRET_KEY=alterar-esta-chave-em-producao
DEBUG=false

# Banco local (desenvolvimento)
DB_NAME=finsaas
DB_USER=postgres
DB_PASSWORD=sua-senha
DB_HOST=localhost
DB_PORT=5432

# No Railway não é necessário: use DATABASE_URL (injetado pelo serviço PostgreSQL).
